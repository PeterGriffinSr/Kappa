(lang dune 3.22)
(name kappa)
(sections (lib .) (libexec .) (bin ../../bin) (doc ../../doc/kappa))
(files
 (lib
  (META
   dune-package
   graph.ml
   infer.ml
   kappa.a
   kappa.cma
   kappa.cmi
   kappa.cmt
   kappa.cmx
   kappa.cmxa
   kappa.ml
   kappa__Graph.cmi
   kappa__Graph.cmt
   kappa__Graph.cmx
   kappa__Infer.cmi
   kappa__Infer.cmt
   kappa__Infer.cmx
   kappa__Lexer.cmi
   kappa__Lexer.cmt
   kappa__Lexer.cmx
   kappa__Parser.cmi
   kappa__Parser.cmt
   kappa__Parser.cmti
   kappa__Parser.cmx
   kappa__Scheme.cmi
   kappa__Scheme.cmt
   kappa__Scheme.cmx
   kappa__Subst.cmi
   kappa__Subst.cmt
   kappa__Subst.cmx
   kappa__Types.cmi
   kappa__Types.cmt
   kappa__Types.cmx
   lexer.ml
   opam
   parser.ml
   parser.mli
   scheme.ml
   subst.ml
   types.ml))
 (libexec (kappa.cmxs))
 (bin (kappa))
 (doc (README.md)))
(library
 (name kappa)
 (kind normal)
 (archives (byte kappa.cma) (native kappa.cmxa))
 (plugins (byte kappa.cma) (native kappa.cmxs))
 (native_archives kappa.a)
 (requires ppx_deriving.runtime)
 (main_module_name Kappa)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name kappa)
     (visibility public)
     (kind alias)
     (source (path Kappa) (impl (path kappa.ml-gen))))
    (name Kappa)
    (modules
     (module
      (obj_name kappa__Graph)
      (visibility public)
      (source (path Graph) (impl (path graph.ml))))
     (module
      (obj_name kappa__Infer)
      (visibility public)
      (source (path Infer) (impl (path infer.ml))))
     (module
      (obj_name kappa__Lexer)
      (visibility public)
      (source (path Lexer) (impl (path lexer.ml))))
     (module
      (obj_name kappa__Parser)
      (visibility public)
      (source (path Parser) (intf (path parser.mli)) (impl (path parser.ml))))
     (module
      (obj_name kappa__Scheme)
      (visibility public)
      (source (path Scheme) (impl (path scheme.ml))))
     (module
      (obj_name kappa__Subst)
      (visibility public)
      (source (path Subst) (impl (path subst.ml))))
     (module
      (obj_name kappa__Types)
      (visibility public)
      (source (path Types) (impl (path types.ml))))))
   (wrapped true))))
